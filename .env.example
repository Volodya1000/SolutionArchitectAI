# Compose interpolation only. Backend production does not read a developer dotenv.
SAA_DATABASE__CREDENTIALS__PASSWORD=local-development-only
SAA_LLM__BASE_URL=http://fake-llm:8000/v1
SAA_LLM__MODEL=fake-chat
# LM Studio: http://host.docker.internal:1234/v1
# Verified LM Studio model: qwen2.5-coder-14b-instruct
# Optional external OpenAI-compatible endpoint credentials:
# SAA_LLM__API_KEY=
# Generation limits may override config/app.yaml:
# SAA_LLM__CONTEXT_WINDOW=4096
# SAA_LLM__OUTPUT_LIMIT=512
# SAA_LLM__CONCURRENCY=1
# SAA_LLM__RETRY__NETWORK_RETRIES=1
# SAA_LLM__RETRY__MAX_TOTAL_REQUESTS=2
# SAA_LLM__RETRY__DEADLINE_SECONDS=120
# SAA_LLM__RETRY__REQUEST_TIMEOUT_SECONDS=60
# SAA_LLM__RETRY__BACKOFF_INITIAL=0.25
# SAA_LLM__RETRY__BACKOFF_MAX=2
# SAA_LLM__RETRY__JITTER=0.1
# SAA_LLM__TEMPERATURE=0.2
# Bootstrap outside Compose: SAA_MODE=development|test|production,
# SAA_CONFIG_ROOT=<absolute configuration root>.
# SQL overrides: SAA_DATABASE__HOST / PORT / USER / DATABASE.
# Durable paths: SAA_GIT__ROOT / SAA_STORAGE__ROOT.
# vLLM overlay uses existing files. Set these in your local environment:
# VLLM_MODEL_DIRECTORY=<existing GGUF directory>
# VLLM_GGUF_FILENAME=Qwen2.5-Coder-14B-Instruct-Q4_K_M.gguf
# VLLM_TOKENIZER_DIRECTORY=<prepared tokenizer directory>
