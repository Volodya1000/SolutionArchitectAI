        "data_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "interaction_id": {
          "format": "uuid",
          "type": "string"
        },
        "interface_id": {
          "format": "uuid",
          "type": "string"
        },
        "kind": {
          "enum": [
            "data_flow",
            "interaction"
          ]
        },
        "properties": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "quality": {
          "$ref": "#/$defs/quality"
        },
        "source_id": {
          "format": "uuid",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "type": "string"
        }
