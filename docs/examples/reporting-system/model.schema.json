{
  "$defs": {
    "approval": {
      "additionalProperties": false,
      "properties": {
        "note": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "not_requested",
            "pending",
            "approved",
            "rejected",
            "stale"
          ]
        }
      },
      "required": [
        "status",
        "note"
      ],
      "type": "object"
    },
    "checks": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "const": "model.schema.json"
        },
        "approval": {
          "$ref": "#/$defs/approval"
        },
        "checks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "basis": {
                "minLength": 1,
                "type": "string"
              },
              "details": {
                "minLength": 1,
                "type": "string"
              },
              "id": {
                "format": "uuid",
                "type": "string"
              },
              "quality": {
                "$ref": "#/$defs/quality"
              },
              "result": {
                "enum": [
                  "passed",
                  "violation",
                  "not_applicable",
                  "not_run"
                ]
              },
              "subject": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "id",
              "subject",
              "basis",
              "result",
              "details",
              "quality"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "method": {
          "minLength": 1,
          "type": "string"
        },
        "record_type": {
          "const": "checks"
        }
      },
      "required": [
        "$schema",
        "record_type",
        "method",
        "approval",
        "checks"
      ],
      "type": "object"
    },
    "decisions": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "const": "model.schema.json"
        },
        "decisions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "alternative": {
                "minLength": 1,
                "type": "string"
              },
              "approval": {
                "$ref": "#/$defs/approval"
              },
              "author": {
                "minLength": 1,
                "type": "string"
              },
              "basis": {
                "minLength": 1,
                "type": "string"
              },
              "id": {
                "format": "uuid",
                "type": "string"
              },
              "proposal": {
                "minLength": 1,
                "type": "string"
              },
              "source_ids": {
                "items": {
                  "format": "uuid",
