              }
            },
            "required": [
              "id",
              "proposal",
              "alternative",
              "basis",
              "author",
              "status",
              "source_ids",
              "approval"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "record_type": {
          "const": "decisions"
        }
      },
      "required": [
        "$schema",
        "record_type",
        "decisions"
      ],
      "type": "object"
    },
    "model": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "const": "model.schema.json"
        },
        "context": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "type": "object"
        },
        "files": {
          "additionalProperties": false,
          "properties": {
            "checks": {
              "const": "checks.json"
            },
            "decisions": {
              "const": "decisions.json"
            },
            "objects": {
              "const": "objects.json"
            },
            "relationships": {
              "const": "relationships.json"
            },
            "requirements": {
              "const": "requirements.json"
            },
            "sources": {
              "const": "sources.json"
            },
            "views": {
              "const": "views.json"
            }
          },
          "required": [
            "objects",
            "relationships",
            "requirements",
            "sources",
            "decisions",
            "views",
            "checks"
          ],
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "record_type": {
          "const": "model"
        },
        "schema_version": {
          "const": "1.1"
        },
        "scope_name": {
          "minLength": 1,
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "$schema",
        "record_type",
        "schema_version",
        "workspace_id",
        "name",
        "scope_name",
        "context",
        "files"
      ],
      "type": "object"
    },
    "object": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "interface"
              }
            }
          },
          "then": {
            "required": [
              "owner_id"
            ]
          }
        }
      ],
      "properties": {
        "alias": {
          "minLength": 1,
          "type": "string"
        },
        "approval": {
          "$ref": "#/$defs/approval"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "kind": {
          "enum": [
            "architecture_object",
            "data",
            "interface"
          ]
        },
        "owner_id": {
          "format": "uuid",
          "type": "string"
        },
        "platform_id": {
          "format": "uuid",
          "type": "string"
        },
        "properties": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "quality": {
          "$ref": "#/$defs/quality"
        },
        "storage_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "id",
        "alias",
        "kind",
        "properties",
        "provenance",
        "quality",
        "approval"
      ],
      "type": "object"
    },
    "objects": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "const": "model.schema.json"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/object"
          },
          "type": "array"
        },
        "record_type": {
          "const": "objects"
        }
      },
      "required": [
        "$schema",
        "record_type",
        "objects"
      ],
      "type": "object"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "автор": {
          "minLength": 1,
          "type": "string"
        },
        "основания": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "тип": {
          "enum": [
            "Предложение",
            "Следствие правила",
            "Следствие требований и контекста",
            "Факт контекста",
            "Факт требований"
          ]
        },
        "фрагмент": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_ids",
        "тип",
        "автор"
      ],
      "type": "object"
    },
    "quality": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "minLength": 1,
          "type": "string"
        },
        "check_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "confirmed",
            "needs_review",
            "violation",
            "insufficient_data"
          ]
        }
      },
      "required": [
        "status",
        "basis",
        "check_ids"
      ],
      "type": "object"
    },
    "relationship": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "data_flow"
              }
            }
          },
          "then": {
            "required": [
              "data_ids",
              "interaction_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "interaction"
              }
            }
          },
          "then": {
            "required": [
              "interface_id"
            ]
          }
        }
      ],
      "properties": {
        "alias": {
          "minLength": 1,
          "type": "string"
        },
        "approval": {
          "$ref": "#/$defs/approval"
