                  "type": "object"
                },
                "type": "array"
              },
              "folder_id": {
                "format": "uuid",
                "type": "string"
              },
              "groups": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "label": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "node_ids": {
                      "items": {
                        "format": "uuid",
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "object_id": {
                      "format": "uuid",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "node_ids"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "id": {
                "format": "uuid",
                "type": "string"
              },
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "nodes": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "label_template": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "notation_type": {
                      "enum": [
                        "Application_Component",
                        "Application_DataObject",
                        "Technology_SystemSoftware"
