  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/model"
    },
    {
      "$ref": "#/$defs/objects"
    },
    {
      "$ref": "#/$defs/relationships"
    },
    {
      "$ref": "#/$defs/requirements"
    },
    {
      "$ref": "#/$defs/sources"
    },
    {
      "$ref": "#/$defs/decisions"
    },
    {
      "$ref": "#/$defs/views"
    },
    {
      "$ref": "#/$defs/checks"
    }
  ],
  "title": "Reporting-system example bundle, schema 1.1; not a complete future product metamodel"
}
