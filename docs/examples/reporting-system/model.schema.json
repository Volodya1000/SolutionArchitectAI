              "renderer": {
                "additionalProperties": false,
                "properties": {
                  "canvas": {
                    "const": "explicit_light_background"
                  },
                  "direction": {
                    "const": "top_to_bottom"
                  },
                  "engine": {
                    "const": "PlantUML"
                  },
                  "image": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "layout": {
                    "const": "automatic"
                  },
                  "scale": {
                    "exclusiveMinimum": 0,
                    "type": "number"
                  },
                  "source": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "engine",
                  "layout",
                  "direction",
                  "scale",
                  "source",
                  "image",
                  "canvas"
                ],
                "type": "object"
