              "id": {
                "format": "uuid",
                "type": "string"
              },
              "media_type": {
                "minLength": 1,
                "type": "string"
              },
              "path": {
                "minLength": 1,
                "type": "string"
              },
              "section": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "size_bytes": {
                "minimum": 0,
                "type": "integer"
              },
              "version_id": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "id",
              "alias",
              "document_id",
              "path",
              "section",
              "version_id",
              "sha256",
              "media_type",
              "size_bytes"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "$schema",
        "record_type",
        "sources"
      ],
      "type": "object"
    },
