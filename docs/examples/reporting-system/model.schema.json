    "requirements": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "const": "model.schema.json"
        },
        "record_type": {
          "const": "requirements"
        },
        "requirements": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[RN]-[0-9]{2}$",
                "type": "string"
              },
              "kind": {
                "enum": [
                  "functional",
                  "nonfunctional"
                ]
              },
              "source_id": {
                "format": "uuid",
                "type": "string"
              },
              "status": {
                "minLength": 1,
                "type": "string"
              },
              "text": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind",
              "text",
              "source_id",
              "status"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "rules": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "exceptions": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "id": {
                "pattern": "^(SEC|ARCH|VIEW)-[0-9]{2}$",
                "type": "string"
              },
              "mandatory": {
                "type": "boolean"
              },
              "source_id": {
                "format": "uuid",
                "type": "string"
              },
              "summary": {
                "minLength": 1,
                "type": "string"
              },
              "text": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "id",
              "text",
              "summary",
              "mandatory",
              "exceptions",
              "source_id"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "$schema",
        "record_type",
        "requirements",
        "rules"
      ],
      "type": "object"
    },
    "sources": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "const": "model.schema.json"
